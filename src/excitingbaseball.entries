# Puntos de entrada que el trazado NO puede deducir solo.
#
# Cada uno lleva escrito POR QUE hace falta.

# El arranque: la cabecera da INIT en 0x8010.
0x8010   # INIT

# La interrupcion del final de la partida: 0x812B escribe 0x82C5 en 0xFDA0 (H.TIMI).
# Jugando no se llega a acabar una partida, asi que no sale en la medida.
0x82C5   # irq_fin

# Ejecutadas en openMSX (tools/omsx_cobertura.tcl: jugando y en la demo) y no alcanzadas por el
