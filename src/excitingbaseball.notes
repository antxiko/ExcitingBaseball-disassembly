# ======================================================================
# EL MOTOR DE SONIDO: tres canales (0xE402, 0xE422, 0xE442, 0x20 bytes)
# ======================================================================
# Cada canal: +0/+1 el principio de su pieza, +2 suena, +3/+4 por donde va,
# +5 la duracion de la nota, +6 lo que le queda de sonar, +7 lo que le queda
# hasta la siguiente, +8 el volumen, +9/+0A su envolvente, +0B el paso de la
# envolvente, +0C el tipo de envolvente, +0D el tempo, +0E su cuenta, +0F/+10
# la vuelta de una repeticion, +11 cuantas faltan, +12 el vibrato. Una pieza
# son grupos de 3 bytes: la nota (o una orden de 0xF3 a 0xFF) y dos bytes de
# argumentos. El canal de la RAM 0 (0xE402) suena en el C del PSG, el 1 en el
# B y el 2 en el A: `sonido_cuadro` cuenta B de 2 a 0 empezando por 0xE402.
L 0xBB37 pieza                     Pone la pieza DE en el canal B y la hace sonar
C 0xBB37 el canal en su estado inicial
C 0xBB3A el principio de la pieza...
C 0xBB3E ...y suena
L 0xBB41 canal                     HL = el canal B (0xE402 + B x 0x20), y lo deja en su estado inicial (0xBDBF)
C 0xBB43 los canales desde 0xE402...
C 0xBB46 ...B por 32
C 0xBB4F desde +2...
C 0xBB52 ...30 bytes de 0xBDBF
L 0xBB5E sonido_calla              Calla el sonido: los tres canales a cero, el PSG sin ruido y los volumenes a 0
C 0xBB5F sin transporte
C 0xBB63 el canal 0...
C 0xBB67 ...el 1...
C 0xBB6B ...y el 2
C 0xBB6E el registro 7 del PSG (RDPSG)...
C 0xBB73 ...los dos bits de los puertos se quedan...
C 0xBB75 ...los tonos apagados (0x38)...
C 0xBB7A ...WRTPSG
C 0xBB7D ninguno suena
C 0xBB87 los tres volumenes a 0
L 0xBB89 sonido_calla_uno          Cada canal
L 0xBB8E canal_para                El canal deja de sonar: el vibrato a cero... en la direccion 0x0012 de la BIOS, no en el canal
C 0xBB8F un "ld (ix+0x12),a" que se quedo en "ld (0x0012),a": escribe en la ROM de la BIOS y no hace nada
L 0xBB92 volumen                   El volumen E en el registro 8 + B del PSG
L 0xBB99 sonido_cuadro             Un cuadro del motor: los tres canales, del 2 al 0
C 0xBB99 empieza por el 2
C 0xBB9B el canal de la RAM 0
L 0xBB9F sonido_cuadro_uno         Un canal
C 0xBBA2 el siguiente...
C 0xBBA7 ...con el numero de canal...
C 0xBBAA ...uno menos
L 0xBBAD canal_cuadro              Un cuadro de un canal: el tempo, la nota, el vibrato y la envolvente
C 0xBBAE el canal en curso
C 0xBBB1 suena?
C 0xBBB6 el tempo...
C 0xBBB9 ...aun no
C 0xBBBA vuelve a su cuenta
C 0xBBC0 la nota acaba?...
C 0xBBC3 ...la siguiente
C 0xBBC6 le queda de sonar?...
C 0xBBC9 ...si no, calla
C 0xBBCB hay vibrato?
C 0xBBD2 lo que le queda...
C 0xBBD8 ...si no ha acabado, la envolvente
L 0xBBE0 vibrato                   El vibrato: el periodo del canal (RDPSG) mas el paso
C 0xBBE5 RDPSG: la parte baja...
C 0xBBEB ...y la alta
C 0xBBF1 el paso...
C 0xBBF7 ...con signo
C 0xBC01 WRTPSG: la parte baja...
C 0xBC06 ...y la alta
L 0xBBFB vibrato_suma              Le suma el paso
L 0xBC09 envolvente                La envolvente: el paso que toca segun lo que le queda a la nota
C 0xBC0C acabada?
C 0xBC12 lo que le queda, por 16...
C 0xBC19 ...entre la duracion
L 0xBC1F envolvente_div            La division, bit a bit
L 0xBC2B envolvente_bit            Un bit del cociente
L 0xBC33 envolvente_paso           El paso: el volumen esta en la mitad alta o baja del byte de la tabla
C 0xBC39 el paso entre 2: el byte...
C 0xBC3F ...de la envolvente
C 0xBC4B el byte...
C 0xBC4E ...su mitad alta
L 0xBC52 envolvente_volumen        El volumen del paso por el del canal, entre 16
L 0xBC5C envolvente_mult           La multiplicacion, bit a bit
L 0xBC62 envolvente_mult_sig       El bit siguiente
L 0xBC6E nota                      La nota siguiente: una nota o una orden (0xF3-0xFF, tabla 0xBDA5)
C 0xBC72 una nota?
C 0xBC75 la orden: 0xFF es la 0, 0xFE la 1...
C 0xBC7B su rutina en la tabla 0xBDA5
C 0xBC81 al acabar, otra nota
C 0xBC89 a la orden
L 0xBC8A nota_pon                  Una nota: A el numero, E la duracion, D hasta la siguiente; duracion 0 es un silencio
C 0xBC93 duracion 0: silencio
L 0xBC98 nota_tono                 El periodo de la nota en el canal B
C 0xBC99 mas el transporte
L 0xBC9F nota_octava               La octava: de 12 en 12
L 0xBCA8 nota_periodo              El periodo de la nota (0xBDD0), partido por 2 por cada octava
L 0xBCB7 nota_octava_baja          Una octava mas arriba
L 0xBCBE nota_escribe              En los registros 2B y 2B+1 del PSG; en el canal 3 (el ruido, registro 6), solo uno
L 0xBCCC nota_envolvente           Si la envolvente es de las de tabla, desde el paso 0
L 0xBCD6 orden_fin                 Orden 0xFF: la pieza se acaba y el canal calla
L 0xBCDE orden_repite              Orden 0xFC: vuelve a la marca si faltan repeticiones
L 0xBCE2 orden_vuelve              Orden 0xFD: vuelve a la marca
L 0xBCE8 orden_salta               Orden 0xF4: salta a DE
L 0xBCEE orden_nada                Orden 0xFE: nada
L 0xBCEF orden_marca               Orden 0xFB: la marca de la repeticion y cuantas veces
L 0xBCFF orden_volumen             Orden 0xFA: el volumen del canal
L 0xBD06 envolvente_psg            La envolvente del PSG: volumen 16 y los registros 11-13
L 0xBD21 orden_envolvente          Orden 0xF9: el tipo de envolvente: del PSG o de la tabla 0xBDE8
L 0xBD3C orden_f8                  Orden 0xF8: no hace nada
L 0xBD3D orden_f7                  Orden 0xF7: no hace nada
